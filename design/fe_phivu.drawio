        <mxCell id="i3z5-Cf7g950V5e5yr6u-47" parent="i3z5-Cf7g950V5e5yr6u-46" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;autosize=1;resizable=0;fontSize=13;container=0;" value="Boundary of&amp;nbsp; FE problem" vertex="1">
          <mxGeometry height="28" width="163" x="41" as="geometry" />
        </mxCell>
        <mxCell id="i3z5-Cf7g950V5e5yr6u-48" parent="i3z5-Cf7g950V5e5yr6u-46" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#FF0000;container=0;dashed=1;" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;" vertex="1">
          <mxGeometry height="20" width="33" y="4" as="geometry" />
        </mxCell>
        <mxCell id="i3z5-Cf7g950V5e5yr6u-50" parent="eYToQM8D4CzLMdLLenoR-70" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;autosize=1;resizable=0;fontSize=13;container=0;" value="&lt;b&gt;Color:&lt;/b&gt;" vertex="1">
          <mxGeometry height="28" width="56" x="4" y="206" as="geometry" />
        </mxCell>
        <mxCell id="eYToQM8D4CzLMdLLenoR-92" parent="1" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;rounded=0;" value="&lt;div&gt;Functional requirements:&lt;/div&gt;&lt;div&gt;FR-01: Unauthorized diagnostic commands related to reprogramming must be filtered&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;QA&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;- Security: MM message route is just in IP, not EP.&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Security&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;Maintainability&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;================================================================================================&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;RDG will handling SID from server and CDC.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;In the CDC case, If RDG is in the ip?, then CDC SID message route is just in the IP. not EP. that is good for security.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;You need to understand why EP and IP separation.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;Basically, TMC think that ECU of external point (communicate with server) has the security risk.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;But they belive if the seaprated partition that is not communicate with server directlry, this will be safer.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;So, CDC is currently securable ECU, they just want to communicate with IP, not EP.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;In the TMC requrement, they just assume that the situation only EP partion has the compromized area.&lt;/div&gt;&lt;div&gt;&amp;nbsp;&lt;/div&gt;&lt;div&gt;02. EP/Internal Partition (Container) - &amp;lt;VS스마트제품개발담당&amp;gt; TOYOTA DCM - Collaboration Center&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&amp;nbsp;&lt;/div&gt;" vertex="1">
          <mxGeometry height="112" width="229" x="-2709" y="1148" as="geometry" />
        </mxCell>
        <mxCell id="eYToQM8D4CzLMdLLenoR-94" parent="1" style="rounded=0;whiteSpace=wrap;html=1;verticalAlign=top;fillColor=none;strokeColor=#0000CC;container=0;movable=1;resizable=1;rotatable=1;deletable=1;editable=1;locked=0;connectable=1;" value="&lt;div&gt;&amp;lt;&amp;lt;LXC container&amp;gt;&amp;gt;&lt;/div&gt;&lt;font style=&quot;font-size: 14px;&quot;&gt;&lt;b&gt;IP Container&lt;/b&gt;&lt;/font&gt;" vertex="1">
          <mxGeometry height="481" width="352" x="-767" y="989" as="geometry" />
        </mxCell>
