                    //uint16_t connectId
                    { "connectId", "connectID" , ArgumentType::Uint , ModeType::Normal}, // item of vector<Argument> with order
                    // android::sp<Buffer> , class: , enum: , argType:android::sp<Buffer>
                    //android::sp<Buffer> udsRequest
                    { "udsRequest", "UDS request" , ArgumentType::android::sp<mindroid::String> , ModeType::Normal}, // item of vector<Argument> with order
                }
            },

            { // onboardclient->onNotifyOBD2Event : mapApi multiple items with <Argument,vector<Argument>>
                {"testOnNotifyOBD2Event" , "Wired connection detection notification event" , ArgumentType::Sldd , ModeType::Privileged }, // api name<Argument> as first item of mapApi
                {   // argument list as second item of map Api with vector<Argument>
