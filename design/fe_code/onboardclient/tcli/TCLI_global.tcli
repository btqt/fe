                    // OBCResponseEventInfo , class:OBCResponseEventInfo , enum: , argType:OBCResponseEventInfo
                    // This is xxClass format
                            
                    //////  (in class) type: uint8_t , name: errCode , len:  , autolenuse:  , slddtype: Uint
