                {"setLogLevel" , "setLogLevel <loglevel#> -- 0:NONE/1:FATAL/2:ERROR/3:WARN/4:INFO/5:DEBUG/6:VERBOSE" , ArgumentType::Sldd , ModeType::Normal }, // api name<Argument> as first item of mapApi
                {   
                    { "lvl", "setLogLevel <loglevel#> -- 0:NONE/1:FATAL/2:ERROR/3:WARN/4:INFO/5:DEBUG/6:VERBOSE" , ArgumentType::Int , ModeType::Normal}, 
                }
            },
            { // setLogLevelAsDefault
                {"setLogLevelAsDefault" , "" , ArgumentType::Sldd , ModeType::Normal }, 
                {   // argument list as second item of map Api with vector<Argument>
                }
            },
            { // getLogLevel
