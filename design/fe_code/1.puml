@startuml
title Direct Diag Command: OEM Server -> CAN (EP/IP Container via Unix socket IPC)

autonumber

actor "OEM Server" as OEM

box "EP Container" #E8F4FD
    participant "MqttMgr /\nHttpMgr" as MGR
    participant "ProxyIpcClient" as PIC
    participant "MessageDispatcher\n(proxy)" as MDP
    participant "UnixSocketClient" as USC
end box

box "IP Container - RemoteDiag" #FDF6E3
    participant "UnixSocketServer" as USS
    participant "ProxyIpcServer" as PIS
    participant "MessageDispatcher\n(rdg)" as MDR
    participant "Remotediag /\nRemotediagHandler" as RDG
    participant "CollectionCondition" as COCO
    participant "SchedulerManager" as SCHED
    participant "RemoteDirectCommand" as RDC
    participant "SidFilter" as SID
    participant "PriorityControl" as PRIO
    participant "OnBoardClient" as OBC
end box

participant "Internal\nCAN bus" as CAN

== 1. Center push notification (MQTT) ==
OEM -> MGR : MQTT publish (topic = VIN)
MGR -> PIC : notify (binder cb, adapter omitted)\nsendCallback(MqttOnNotifyReceived, DceNotification)
PIC -> PIC : queue mPendingCallbacks\n(callback drain thread)
PIC -> USC : send(Frame: CALLBACK)
USC -> USS : UDS socket\n/dev/socket/remotediag/remotediag_proxy.sock
USS -> PIS : onFrameReceived(frame)
PIS -> MDR : dispatchCallback(MqttOnNotifyReceived)\n(callback dispatch thread)
MDR -> RDG : MSG_CENTER_PUSH_RECEIVED\n(Mqtt CallbackHandler omitted)
RDG -> COCO : onReceivedCenterRequest()\n(IG ON check)

== 2. Fetch collection condition (gRPC qua proxy) ==
COCO -> PIS : requestAPICall(HttpSendGrpc,\nGetCollectionConditionRequest)
PIS -> USS : send(Frame: REQUEST, correlationId)
USS -> USC : UDS socket
USC -> PIC : onFrameReceived -> handleRequest\n(request dispatch thread)
PIC -> MDP : dispatchCommand(HttpSendGrpc)
MDP -> MGR : sendGrpcMessageRaw (binder, adapter omitted)
MGR -> OEM : HTTPS/gRPC GetCollectionCondition
PIC --> PIS : Frame: RESPONSE (callId)
OEM --> MGR : CollectionCondition\n(DirectCommand list: ECU addr + command_messages)
MGR -> PIC : sendCallback(HttpGrpcResponse, GrpcResData)
PIC -> USC : send(Frame: CALLBACK)
USC -> USS : UDS socket
USS -> PIS : onFrameReceived(frame)
PIS -> MDR : dispatchCallback(HttpGrpcResponse)
MDR -> RDG : MSG_RPC_MESSAGE_RECEIVED
RDG -> COCO : notifyReceiveGrpcRes(resData)\n-> parse DirectCommand collection
COCO -> SCHED : handleNewCenterReqData(CenterReqData)
SCHED -> RDG : trigger theo schedule
RDG -> RDC : receiveCenterCommnad ->\nonCenterCommandForward(MSG_ID_CENTERREQUESTDIRECTCOMMAND)

== 3. Priority control + SID filter ==
RDC -> PRIO : requestTriggerProcess(DiagTrigger\nDIRECT_COMMAND, prio)
PRIO -> PRIO : addDiagTrigger -> getHighestPriorityTask
PRIO --> RDC : notifyTrigger(TRIGGER_START)
RDC -> RDC : sendDirectCommand()
loop mỗi DirectCommand trong collection
    RDC -> RDC : validateDirectCommand(ECU addr/phase)
    RDC -> SID : isAllowed(udsReq->data(), size)
    alt SID bị chặn (0x10-02, 0x11, 0x28, 0x34, 0x85)
        SID --> RDC : false
        RDC -> RDC : set SC_COMMAND_ERROR\n(khong gui xuong CAN)
    else SID hợp lệ
        SID --> RDC : true
        RDC -> RDC : push DirectCommandTransmission\n(+0x10 40 remote session nếu Phase 5)
    end
end

== 4. Transmit UDS xuống CAN ==
RDC -> OBC : connect(transportInfo)\n(OnboardclientAdapter binder, cùng IP container)
RDC -> OBC : DirectCommandTransmission::sendUds()\n-> sendUdsData(connectId, udsReq)
OBC -> CAN : UDS request (CAN/CAN-FD)
CAN --> OBC : UDS response
OBC --> RDG : MSG_OBC_UDS_RESPONSE_RECEIVED
RDG -> RDC : onReceiveUDS(responseEventInfo)
RDC -> RDC : makeUploadData()\n-> upload kết quả về OEM (lặp lại đường HttpSendGrpc ở bước 2)
@enduml